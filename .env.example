# =============================================================================
#  MODELO DO ARQUIVO DE CHAVES
#  1. Faça uma cópia deste arquivo com o nome .env.local (na mesma pasta).
#  2. Preencha os valores no .env.local, nunca aqui.
#  O .env.local nunca é enviado ao GitHub (está bloqueado no .gitignore).
# =============================================================================

# Chave da API da Anthropic (começa com sk-ant-). Veja o README.
ANTHROPIC_API_KEY=

# Só para testes técnicos: permite analisar links de endereços locais.
# Deixe comentado (com # na frente) no uso normal.
# UNSLANT_ALLOW_LOCAL_URLS=true
